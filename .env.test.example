# Test-only template. Use an isolated PostgreSQL/Testcontainers database, never Neon production.
APP_NAME=skillbridge-api-test
SPRING_PROFILES_ACTIVE=test
SERVER_PORT=0
API_BASE_PATH=/api/v1
REQUEST_ID_HEADER=X-Request-Id

# Leave DATABASE_URL empty when Testcontainers supplies dynamic JDBC properties.
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
TESTCONTAINERS_ENABLED=true
TESTCONTAINERS_POSTGRES_IMAGE=postgres:16-alpine
FLYWAY_ENABLED=true
JPA_DDL_AUTO=validate
OPEN_SESSION_IN_VIEW=false

# Non-production test signing material only.
JWT_SECRET=test-only-secret-change-me-to-at-least-256-bits
JWT_ISSUER=skillbridge-api
JWT_AUDIENCE=skillbridge-frontend
ACCESS_TOKEN_MINUTES=1440
REFRESH_TOKEN_DAYS=30
PASSWORD_HASH_COST=4
FRONTEND_ORIGINS=http://localhost:5173
API_PROBLEM_MEDIA_TYPE=application/problem+json
APP_TIME_ZONE=UTC
STORAGE_PROVIDER=fake
