# Staging Environment Configuration (.env.staging)
# Copy to .env.staging and customize for your staging environment

# Database Configuration
DATABASE_URL=jdbc:postgresql://postgres:5432/skillbridge
DATABASE_USERNAME=skillbridge
DATABASE_PASSWORD=skillbridge_staging_password

# Server Configuration
SERVER_PORT=9095
FLYWAY_ENABLED=true

# Storage Configuration
STORAGE_PROVIDER=filesystem
STORAGE_BASE_PATH=/app/storage/certificates

# Security Configuration
JWT_SECRET=staging_jwt_secret_key_change_in_production_immediately
ACCESS_TOKEN_MINUTES=720
REFRESH_TOKEN_DAYS=7

# Application Configuration
REGISTRATION_BONUS_POINTS=30
HELPFUL_REWARD=5
ESCROW_AUTO_RELEASE_HOURS=18

# CORS Configuration (frontend URLs)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://127.0.0.1:3000,http://127.0.0.1:5173

# Logging
LOGGING_LEVEL_COM_SKILLBRIDGE=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=WARN
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=DEBUG
