# ============================================================================
# SKILLBRIDGE BACKEND - PRODUCTION ENVIRONMENT CONFIGURATION EXAMPLE
# ============================================================================
# Copy this file to backend/.env.production and fill in your actual values
# DO NOT commit actual secrets - use GitHub Secrets instead
# ============================================================================

# Database Configuration (Production)
DATABASE_URL=postgresql://user:password@host:port/skillbridge?sslmode=require
DATABASE_USERNAME=production_user
DATABASE_PASSWORD=production_password_here

# Connection Pool Settings - Production
DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
DATASOURCE_HIKARI_MINIMUM_IDLE=10
DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000

# Flyway - Database Migrations
FLYWAY_ENABLED=true
FLYWAY_OUT_OF_ORDER=false
FLYWAY_VALIDATE_ON_MIGRATE=true

# Server Configuration (Production)
SERVER_PORT=9095
SERVER_SERVLET_CONTEXT_PATH=/
SERVER_COMPRESSION_ENABLED=true
SERVER_COMPRESSION_MIN_RESPONSE_SIZE=1024
SERVER_ERROR_INCLUDE_MESSAGE=never
SERVER_ERROR_INCLUDE_STACKTRACE=never

# JWT Security (Production - MUST CHANGE!)
JWT_SECRET=generate_with_openssl_rand_-base64_32
JWT_EXPIRATION_TIME=86400000
JWT_REFRESH_TOKEN_EXPIRATION_TIME=604800000

# CORS Configuration (Production)
SKILLBRIDGE_CORS_ALLOWED_ORIGINS=https://skillbridge.dev,https://www.skillbridge.dev

# JPA & Hibernate (Production)
JPA_HIBERNATE_DDL_AUTO=validate
JPA_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQL10Dialect
JPA_HIBERNATE_FORMAT_SQL=false
JPA_SHOW_SQL=false
JPA_PROPERTIES_HIBERNATE_JDBC_BATCH_SIZE=20

# Logging (Production - Minimal)
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_COM_SKILLBRIDGE=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=WARN
LOGGING_FILE_NAME=logs/skillbridge.log

# Actuator - Production
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized

# Application Profile
SPRING_PROFILES_ACTIVE=production

# Frontend Configuration (Production)
FRONTEND_URL=https://skillbridge.dev
FRONTEND_ORIGINS=https://skillbridge.dev,https://www.skillbridge.dev
