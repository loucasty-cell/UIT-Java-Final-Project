# ==========================================
# SkillBridge Frontend Environment Variables
# ==========================================
# Backend API Base URL
# Default local port: http://localhost:9095
VITE_API_BASE_URL=http://localhost:9095

# ==========================================
# SkillBridge Backend Environment Variables
# ==========================================
# Local backend template. Copy to a private .env file; do not commit that file.
APP_NAME=skillbridge-api
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=9095
API_BASE_PATH=/api/v1
REQUEST_ID_HEADER=X-Request-Id

# Neon PostgreSQL connection
DATABASE_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
DATABASE_USERNAME=<neon-runtime-role>
DATABASE_PASSWORD=<local-secret>
DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_MIN_IDLE=1
DATABASE_MIGRATION_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
DATABASE_MIGRATION_USERNAME=<neon-migration-role>
DATABASE_MIGRATION_PASSWORD=<local-secret>
FLYWAY_ENABLED=true
JPA_DDL_AUTO=validate
OPEN_SESSION_IN_VIEW=false

# Backend-owned authentication
JWT_SECRET=<at-least-256-bit-local-secret>
JWT_ISSUER=skillbridge-api
JWT_AUDIENCE=skillbridge-frontend
ACCESS_TOKEN_MINUTES=1440
REFRESH_TOKEN_DAYS=30
PASSWORD_HASH_COST=12

# REST/CORS boundary
FRONTEND_ORIGINS=http://localhost:8081,http://localhost:8080,http://localhost:5173,http://localhost:3000,http://localhost:*,https://<lovable-domain>
API_PROBLEM_MEDIA_TYPE=application/problem+json
APP_TIME_ZONE=UTC

# Keep storage provider credentials out of Git
STORAGE_PROVIDER=disabled
